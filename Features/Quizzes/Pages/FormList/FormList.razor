@page "/"
@page "/forms"
@using Quiz.Features.Quizzes.Components

<div class="form-list-container">
    <h3>New form</h3>

    <a class="link-add-form" href="/QuizApp/create-form">
        <img src="https://ssl.gstatic.com/docs/templates/thumbnails/forms-blank-googlecolors.png" alt="+ image" />
    </a>

    @if (isLoading)
    {
        <div class="loading">Loading forms...</div>
    }
    else
    {
        <ul class="form-card-list-container">
            @if (forms != null && forms.Any())
            {
                @foreach (var form in forms)
                {
                    <li>
                        <FormCard Form="@form" />
                    </li>
                }
            }
            else
            {
                <li class="not-available-forms">No forms available</li>
            }
        </ul>
    }
</div>
