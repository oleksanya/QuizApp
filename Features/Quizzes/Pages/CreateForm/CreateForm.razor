@page "/create-form"
@using Quiz.Features.Quizzes.Components

<div class="page-container">
    <div class="form-container">

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-error" : "alert-success")">
                @message
            </div>
        }

        <div class="form-header" tabindex="0">
            <input type="text" @bind="form.Title" class="input-text form-title-input" required />

            <input type="text" @bind="form.Description" placeholder="Form description" class="input-text form-description-input" required />
        </div>

        <div class="form-questions">
            @foreach (var q in form.Questions)
            {
                <QuestionEdit Question="q" OnRemove="() => RemoveQuestion(q)" />
            }
        </div>

        <div class="form-buttons-panel">
            <button class="btn-panel" @onclick="AddQuestion" disabled="@isLoading">+</button>

            <button class="btn-save" @onclick="SaveForm" disabled="@isLoading">
                <span>@(isLoading ? "Saving..." : "Save form")</span>
            </button>
        </div>
    </div>
</div>