@page "/create-form"
@page "/edit-form/{FormId}"
@using Quiz.Features.Quizzes.Components

<div class="page-container">
    <MudTabs Class="mb-4" Centered="true">
        <MudTabPanel Text="All questions">
            <div class="form-container">
                <div class="form-header" tabindex="0">
                    <input type="text" @bind="form.Title" class="input-text form-title-input" required />

                    <input type="text" @bind="form.Description" placeholder="Form description" class="input-text form-description-input" required />
                </div>

                <div class="form-questions" id="questions-list">
                    @foreach (var q in form.Questions)
                    {
                        <div class="draggable-question" data-id="@q.Id">
                            <div class="drag-handle" title="Drag to reorder">
                                <span class="dots">⋮⋮</span>
                            </div>
                            <div class="question-wrapper">
                                <QuestionEdit Question="q" OnRemove="() => RemoveQuestion(q)" />
                            </div>
                        </div>
                    }
                </div>

                <div class="form-buttons-panel">
                    <button class="btn-panel" @onclick="AddQuestion" disabled="@isLoading">+</button>

                    <button class="btn-save" @onclick="SaveOrUpdate" disabled="@isLoading">
                        <span>@(isLoading ? (IsEditMode ? "Updating..." : "Saving...") : (IsEditMode ? "Update form" : "Save form"))</span>
                    </button>
                </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Quiz results" @onclick="OnQuizResultsTabClick">
            @if (IsEditMode && !string.IsNullOrWhiteSpace(FormId))
            {
                <QuizResults FormId="@FormId" />
            }
        </MudTabPanel>
    </MudTabs>
</div>